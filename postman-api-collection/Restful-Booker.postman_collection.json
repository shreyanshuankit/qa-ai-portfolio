{
  "info": {
    "_postman_id": "c3e8f1a0-4b72-4d91-9e55-2a6c0f84d1b7",
    "name": "Restful Booker API (Portfolio sample)",
    "description": "Portfolio sample for Shreyanshu Santosh. Collection v2.1 against the public Restful Booker practice API (https://restful-booker.herokuapp.com). Auth token and bookingid are chained through environment variables. Published demo credentials only. Not client work.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth \u2014 obtain token (published demo credentials)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is JSON with a token\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.token).to.be.a(\"string\").and.to.have.lengthOf.above(0);",
              "    pm.environment.set(\"token\", body.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      }
    },
    {
      "name": "Create booking \u2014 store bookingid",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"bookingid is a positive integer and is saved\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.bookingid).to.be.a(\"number\").and.to.be.above(0);",
              "    pm.expect(body.booking.firstname).to.eql(\"Ada\");",
              "    pm.expect(body.booking.lastname).to.eql(\"Lovelace\");",
              "    pm.environment.set(\"bookingid\", String(body.bookingid));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/booking",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstname\": \"Ada\",\n  \"lastname\": \"Lovelace\",\n  \"totalprice\": 120,\n  \"depositpaid\": true,\n  \"bookingdates\": { \"checkin\": \"2026-12-01\", \"checkout\": \"2026-12-05\" },\n  \"additionalneeds\": \"Breakfast\"\n}"
        }
      }
    },
    {
      "name": "Get booking by stored bookingid",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Body matches the booking we created\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.firstname).to.eql(\"Ada\");",
              "    pm.expect(body.lastname).to.eql(\"Lovelace\");",
              "    pm.expect(body.totalprice).to.eql(120);",
              "    pm.expect(body.additionalneeds).to.eql(\"Breakfast\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingid}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking",
            "{{bookingid}}"
          ]
        }
      }
    },
    {
      "name": "Update booking (PUT) with token cookie",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"All fields were replaced\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.firstname).to.eql(\"Grace\");",
              "    pm.expect(body.lastname).to.eql(\"Hopper\");",
              "    pm.expect(body.totalprice).to.eql(200);",
              "    pm.expect(body.additionalneeds).to.eql(\"Late checkout\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token={{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingid}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking",
            "{{bookingid}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstname\": \"Grace\",\n  \"lastname\": \"Hopper\",\n  \"totalprice\": 200,\n  \"depositpaid\": false,\n  \"bookingdates\": { \"checkin\": \"2026-12-10\", \"checkout\": \"2026-12-12\" },\n  \"additionalneeds\": \"Late checkout\"\n}"
        }
      }
    },
