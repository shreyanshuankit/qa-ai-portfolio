{
  "name": "qa-portfolio-playwright-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Sample / demo Playwright UI + API test suite for public practice targets only. Portfolio sample — not client work.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "qa",
    "sample",
    "demo",
    "api-testing"
  ],
  "author": "Shreyanshu Santosh",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
